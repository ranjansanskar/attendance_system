# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase → Project Settings → API → service_role key (SECRET: never share, never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Random secret for signing QR codes and student sessions. Generate with:  openssl rand -base64 48
APP_SECRET=
